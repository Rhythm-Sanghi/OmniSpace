{
  "name": "omni-space",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Omni-Space: A Unified, P2P, Cross-Device Window Manager",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "core",
    "ui",
    "signaling-server",
    "desktop",
    "mobile-pwa"
  ],
  "scripts": {
    "dev:all": "concurrently --kill-others \"npm run dev -w signaling-server\" \"npm run dev -w desktop\" \"npm run dev -w mobile-pwa\"",
    "dev:signaling": "npm run dev -w signaling-server",
    "dev:desktop": "npm run dev -w desktop",
    "dev:pwa": "npm run dev -w mobile-pwa",
    "build": "node scripts/build-pages.js",
    "build:all": "npm run build -w signaling-server && npm run build -w desktop && npm run build -w mobile-pwa",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node --input-type=module -e \"import fs from 'fs'; ['desktop/dist','mobile-pwa/dist','signaling-server/dist'].forEach(d => fs.rmSync(d, {recursive: true, force: true}))\"",
    "cargo:check": "cargo check --manifest-path desktop/src-tauri/Cargo.toml",
    "cargo:clippy": "cargo clippy --manifest-path desktop/src-tauri/Cargo.toml -- -D warnings",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
